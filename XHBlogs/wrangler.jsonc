{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cybermot-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cybermot-site"
    }
  ]
  // The Worker name and the self-reference binding must both point at
  // cybermot-site: that is the account's only Worker and the one the
  // cybermot.bomber.asia custom domain is attached to.
}
